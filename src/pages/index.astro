---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import Experience from '../components/Experience.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Publications from '../components/Publications.astro';
import Now from '../components/Now.astro';
import { loadContent } from '../lib/content';

const { bio, skills, experience, works, publications, publicationIndexes, collabGraph } =
  loadContent();

const description = `${bio.title}. ${bio.pitch.trim()}`;
const title = `${bio.name} · ${bio.title}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: bio.name,
  jobTitle: bio.title,
  description: bio.pitch.trim(),
  email: bio.email,
  url: 'https://moldovannorbert.github.io/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Amsterdam',
    addressCountry: 'NL',
  },
  sameAs: [bio.links.github, bio.links.scholar, bio.links.linkedin, bio.links.orcid],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main id="main">
    <Hero bio={bio} />
    <Pillars skills={skills} />
    <Experience experience={experience} />
    <FeaturedWork works={works} />
    <Publications
      graph={collabGraph}
      indexes={publicationIndexes}
      highlights={publications.featured}
    />
  </main>
  <Now bio={bio} />
</BaseLayout>
