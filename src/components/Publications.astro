---
import type { Publications } from '../lib/schema';

interface Props {
  publications: Publications;
}

const { publications } = Astro.props;
---

<section class="section" id="publications" aria-labelledby="pubs-title">
  <div class="wrap">
    <h2 class="section__title" id="pubs-title">Publications</h2>
    <p class="section__lead">
      Selected papers; full list on Scholar, ORCID, and Scopus.
    </p>

    <ol class="pubs">
      {
        publications.featured.map((pub) => (
          <li class="pub">
            <p class="pub__meta">
              {pub.year} · {pub.venue} · PMID {pub.pmid}
            </p>
            <h3 class="pub__title">{pub.title.trim()}</h3>
            <p class="pub__finding prose">{pub.finding.trim()}</p>
            <p class="pub__links">
              <a href={pub.doi}>DOI</a>
              <a href={pub.pubmed}>PubMed</a>
              {pub.code && <a href={pub.code}>Code</a>}
            </p>
          </li>
        ))
      }
    </ol>

    <p class="indexes">
      All publications:
      <a href={publications.indexes.scholar}>Google Scholar</a>
      ·
      <a href={publications.indexes.orcid}>ORCID</a>
      ·
      <a href={publications.indexes.scopus}>Scopus</a>
    </p>
  </div>
</section>

<style>
  .pubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pub {
    padding: 1.15rem 0;
    border-top: 1px solid var(--border);
  }

  .pub:last-child {
    border-bottom: 1px solid var(--border);
  }

  .pub__meta {
    margin: 0 0 0.3rem;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--muted);
  }

  .pub__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .pub__finding {
    margin: 0 0 0.65rem;
    color: var(--ink);
  }

  .pub__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    margin: 0;
  }

  .pub__links a {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .pub__links a:hover {
    border-bottom-color: var(--accent);
  }

  .indexes {
    margin: 1.5rem 0 0;
    color: var(--muted);
  }

  .indexes a {
    font-weight: 600;
  }
</style>
