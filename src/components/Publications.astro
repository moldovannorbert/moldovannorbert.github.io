---
import type { CollabGraph, PublicationIndexes, Publications, Technique } from '../lib/schema';

interface Props {
  graph: CollabGraph;
  indexes: PublicationIndexes;
  highlights: Publications['featured'];
}

const { graph, indexes, highlights } = Astro.props;

const techniqueOrder = [
  'cfdna_fragmentomics',
  'longread_cfdna',
  'cfdna_genomics_epigenomics',
  'longread_rna',
  'other',
] as const satisfies readonly Technique[];

const techniqueClass: Record<Technique, string> = {
  longread_rna: 'tech-longread-rna',
  cfdna_fragmentomics: 'tech-fragmentomics',
  cfdna_genomics_epigenomics: 'tech-genomics',
  longread_cfdna: 'tech-longread-cfdna',
  other: 'tech-other',
};

const techniqueCssVar: Record<Technique, string> = {
  longread_rna: 'var(--tech-longread-rna)',
  cfdna_fragmentomics: 'var(--tech-fragmentomics)',
  cfdna_genomics_epigenomics: 'var(--tech-genomics)',
  longread_cfdna: 'var(--tech-longread-cfdna)',
  other: 'var(--tech-other)',
};

const years = graph.papers.map((p) => p.year).filter((y): y is number => y != null);
const yearMin = years.length ? Math.min(...years) : 2017;
const yearMax = years.length ? Math.max(...years) : 2025;
const yearTicks = Array.from({ length: yearMax - yearMin + 1 }, (_, i) => yearMax - i);

const byYear = new Map<number, typeof graph.papers>();
for (const y of yearTicks) byYear.set(y, []);
for (const p of graph.papers) {
  if (p.year == null) continue;
  const list = byYear.get(p.year) ?? [];
  list.push(p);
  byYear.set(p.year, list);
}
for (const list of byYear.values()) {
  list.sort((a, b) => Number(b.led) - Number(a.led) || a.title.localeCompare(b.title));
}

const tile = 19; // was 21; ~10% smaller
const gap = 4;
const yearGap = 10;
const padL = 44;
const padR = 12;
const padT = 8;
const padB = 8;
const maxCount = Math.max(1, ...[...byYear.values()].map((list) => list.length));
const rowPitch = tile + yearGap;
const W = padL + maxCount * (tile + gap) + padR;
const H = padT + yearTicks.length * rowPitch - yearGap + tile + padB;

const rows = yearTicks.map((year, i) => {
  const y = padT + i * rowPitch;
  const papers = (byYear.get(year) ?? []).map((p, idx) => ({
    ...p,
    year,
    x: padL + idx * (tile + gap),
    y,
    color: techniqueCssVar[p.technique as Technique],
  }));
  return { year, y, papers };
});

const marks = rows.flatMap((r) => r.papers);

const byTechnique = techniqueOrder
  .map((id) => ({
    id,
    label: graph.techniqueLabels[id],
    count: graph.counts.byTechnique[id] ?? 0,
    papers: graph.papers.filter((p) => p.technique === id),
  }))
  .filter((t) => t.count > 0);

const chartPapers = marks.map((m) => ({
  id: m.id,
  title: m.title,
  year: m.year,
  venue: m.venue,
  url: m.url,
  technique: m.technique,
  led: m.led,
  label: graph.techniqueLabels[m.technique],
}));
---

<section class="section" id="publications" aria-labelledby="pubs-title">
  <div class="wrap">
    <h2 class="section__title" id="pubs-title">Publications</h2>
    <p class="section__lead">
      A {graph.counts.papers} paper journey in the world of NGS multi-omics.
    </p>

    <div class="pubs-layout">
      <div class="works pubs-highlights">
        <h3 class="pubs-highlights__title">Selected publications</h3>
        {
          highlights.map((work) => (
            <article class="work">
              <header class="work__head">
                <p class="work__meta">
                  {work.year} · {work.venue}
                </p>
                <h3 class="work__title">{work.title.trim()}</h3>
              </header>
              <dl class="work__fields">
                <div>
                  <dt>Impact</dt>
                  <dd class="prose">{work.impact.trim()}</dd>
                </div>
              </dl>
              <ul class="work__tags">
                {work.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              <p class="work__links">
                {work.code && (
                  <a
                    class="work__link"
                    href={work.code}
                    aria-label="Repository"
                    title="Repository"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                      ></path>
                    </svg>
                  </a>
                )}
                <a
                  class="work__link"
                  href={work.pubmed}
                  aria-label="PubMed"
                  title="PubMed"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M8.23 7.982l.006-1.005C7.846 1.417 5.096 0 5.096 0l.048 2.291C3.73 1.056 2.6 1.444 2.6 1.444l.118 15.307s4.218-1.796 5.428 5.505C10.238 13.535 21.401 24 21.401 24V9S10.52-.18 8.231 7.982zm9.79 9.941l-1.046-5.232-1.904 4.507h-.96l-1.72-4.301-1.046 5.04H9.321l2.093-9.39h.802l2.491 5.543 2.508-5.557h.869l2.075 9.39h-2.138z"
                    ></path>
                  </svg>
                </a>
                <a
                  class="work__link"
                  href={work.doi}
                  aria-label="DOI"
                  title="DOI"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M24 12c0 6.633-5.367 12-12 12S0 18.633 0 12 5.367 0 12 0s12 5.367 12 12ZM7.588 6.097v4.471c-.663-.925-1.403-1.373-2.406-1.373-2.046 0-3.244 1.441-3.244 3.847 0 2.357 1.325 3.848 3.166 3.848 1.12 0 1.88-.4 2.445-1.325l-.039 1.042h2.045V6.097Zm-1.763 8.942c-1.12 0-1.802-.76-1.802-2.045 0-1.325.682-2.085 1.802-2.085 1.081 0 1.802.76 1.802 2.085 0 1.285-.672 2.045-1.802 2.045Zm12.253-1.948c0-2.172-1.578-3.789-3.906-3.789-2.328 0-3.945 1.695-3.945 3.789 0 2.133 1.578 3.789 3.945 3.789 2.289 0 3.906-1.656 3.906-3.789Zm-2.094-.01c0 1.14-.711 1.89-1.851 1.89-1.139 0-1.851-.75-1.851-1.89 0-1.139.712-1.89 1.851-1.89 1.149 0 1.861.751 1.851 1.89Zm2.6-5.795c0 .633.517 1.227 1.189 1.227.633 0 1.188-.555 1.188-1.227a1.17 1.17 0 0 0-1.188-1.189c-.672 0-1.179.556-1.189 1.189Zm.166 9.341h2.055V9.604H18.75Z"
                    ></path>
                  </svg>
                </a>
              </p>
            </article>
          ))
        }
      </div>

      <aside class="pubs-viz collab" data-collab>
        <div class="collab__legends">
          <p class="collab__counts" aria-label="Techniques">
            {
              byTechnique.map((t) => (
                <span class="collab__count-item">
                  <span class:list={['collab__swatch', techniqueClass[t.id]]} aria-hidden="true" />
                  {t.label}
                </span>
              ))
            }
          </p>
        </div>

        <div class="collab__stage" data-collab-stage>
          <svg
            class="collab__svg"
            viewBox={`0 0 ${W} ${H}`}
            role="img"
            aria-label="Publication activity by year from present to past"
          >
            <line
              x1={padL - 6}
              y1={padT}
              x2={padL - 6}
              y2={padT + (yearTicks.length - 1) * rowPitch + tile}
              class="collab__baseline"
            />

            {
              rows.map((row, yearIdx) => (
                <g class="collab__row">
                  <text
                    x={padL - 12}
                    y={row.y + tile / 2}
                    text-anchor="end"
                    dominant-baseline="middle"
                    class="collab__axis-label"
                  >
                    {row.year}
                  </text>
                  {row.papers.map((m, paperIdx) => (
                    <rect
                      class="collab__mark"
                      data-paper-id={m.id}
                      x={m.x}
                      y={m.y}
                      width={tile}
                      height={tile}
                      rx="2.7"
                      ry="3"
                      fill={m.color}
                      style={`cursor: pointer; --col: ${yearIdx}; --row: ${paperIdx}`}
                    />
                  ))}
                </g>
              ))
            }
          </svg>
          <div class="collab__tooltip" data-collab-tooltip hidden></div>
        </div>

        <p class="collab__caption">
          Data fetched by OpenAlex (<a href={indexes.orcid} target="_blank" rel="noopener noreferrer">ORCID</a>).
        </p>
      </aside>

      <details class="collab__list pubs-list">
        <summary>All publications ({graph.counts.papers})</summary>
        {
          byTechnique.map((t) => (
            <div class="collab__group">
              <h3 class="collab__group-title">{t.label}</h3>
              <ol>
                {t.papers.map((p) => (
                  <li>
                    <span class="collab__list-meta">
                      {p.year ?? 'n.d.'}
                      {p.openAlexType === 'preprint' ? ' · Preprint' : ''}
                      {p.venue ? ` · ${p.venue}` : ''}
                    </span>
                    <a href={p.url} target="_blank" rel="noopener noreferrer">
                      {p.title}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </details>
    </div>
  </div>

  <script id="collab-chart-data" type="application/json" set:html={JSON.stringify(chartPapers)} />
</section>

<style>
  .pubs-layout {
    display: grid;
    gap: 2.5rem 2.75rem;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    grid-template-areas:
      'viz highlights'
      'viz list';
    align-items: start;
  }

  .pubs-highlights {
    grid-area: highlights;
  }

  .pubs-highlights__title {
    margin: 0 0 0.15rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pubs-viz {
    grid-area: viz;
    position: sticky;
    top: calc(var(--nav-h) + 1rem);
  }

  .pubs-list {
    grid-area: list;
  }

  @media (max-width: 920px) {
    .pubs-layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        'viz'
        'highlights'
        'list';
    }

    .pubs-viz {
      position: static;
    }
  }

  .works {
    display: flex;
    flex-direction: column;
  }

  .work {
    padding: 1.75rem 0;
    border-top: 1px solid var(--border);
  }

  .work__meta {
    margin: 0 0 0.35rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
  }

  .work__title {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .work__fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 1.1rem;
  }

  .work__fields dt {
    margin: 0 0 0.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .work__fields dd {
    margin: 0;
    color: var(--ink);
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
  }

  .work__tags li {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }

  .work__tags li:not(:last-child)::after {
    content: '·';
    margin-left: 0.65rem;
    color: var(--border);
  }

  .work__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
  }

  .work__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--ink);
    text-decoration: none;
    border-radius: 3px;
    transition: color 160ms var(--ease), background 160ms var(--ease);
  }

  .work__link:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .work__link svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .collab__legends {
    margin: 0 0 1rem;
  }

  .collab__counts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.15rem;
    margin: 0 0 0.55rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .collab__count-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .collab__swatch {
    width: 0.675rem;
    height: 0.675rem;
    border-radius: 2.7px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .collab__swatch.tech-longread-rna {
    background: var(--tech-longread-rna);
  }
  .collab__swatch.tech-fragmentomics {
    background: var(--tech-fragmentomics);
  }
  .collab__swatch.tech-genomics {
    background: var(--tech-genomics);
  }
  .collab__swatch.tech-longread-cfdna {
    background: var(--tech-longread-cfdna);
  }
  .collab__swatch.tech-other {
    background: var(--tech-other);
  }

  .collab__stage {
    position: relative;
    width: 100%;
    overflow-x: auto;
  }

  .collab__svg {
    width: 100%;
    height: auto;
    min-height: 18rem;
  }

  .collab__mark {
    opacity: 0;
    transform: translateY(10px) scale(0.55);
    transform-box: fill-box;
    transform-origin: center;
    visibility: hidden;
    pointer-events: none;
  }

  .collab__stage.is-inview .collab__mark {
    animation: collab-tile-pop 480ms var(--ease) both;
    animation-delay: calc(var(--col, 0) * 70ms + var(--row, 0) * 28ms);
    visibility: visible;
    pointer-events: auto;
  }

  .collab__mark:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @keyframes collab-tile-pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.55);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collab__mark {
      opacity: 1;
      transform: none;
    }

    .collab__stage.is-inview .collab__mark {
      animation: none;
    }
  }

  .collab__axis-label {
    font-size: 11px;
    fill: var(--muted);
  }

  .collab__baseline {
    stroke: var(--border);
    stroke-width: 1;
  }

  .collab__tooltip {
    position: absolute;
    z-index: 2;
    max-width: min(18rem, 70%);
    padding: 0.55rem 0.7rem;
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    pointer-events: none;
  }

  .collab__caption {
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .collab__caption a {
    font-weight: 600;
  }

  .collab__list {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .collab__list summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--ink);
  }

  .collab__group {
    margin-top: 1.25rem;
  }

  .collab__group-title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .collab__list ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collab__list li {
    padding: 0.75rem 0;
    border-top: 1px solid var(--border);
  }

  .collab__list-meta {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .collab__list a {
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .collab__list a:hover {
    border-bottom-color: var(--accent);
  }
</style>

<script>
  const dataEl = document.getElementById('collab-chart-data');
  const root = document.querySelector('[data-collab]');
  if (!dataEl || !root) throw new Error('collab mount missing');

  /** @type {Array<{id:string,title:string,year:number,venue:string,url:string,technique:string,led:boolean,label:string}>} */
  const papers = JSON.parse(dataEl.textContent || '[]');
  const byId = new Map(papers.map((p) => [p.id, p]));

  const stage = root.querySelector('[data-collab-stage]');
  const tooltip = root.querySelector('[data-collab-tooltip]');
  if (!(stage instanceof HTMLElement) || !(tooltip instanceof HTMLElement)) {
    throw new Error('collab elements missing');
  }

  function placeTooltip(event) {
    const rect = stage.getBoundingClientRect();
    const tw = tooltip.offsetWidth;
    const th = tooltip.offsetHeight;
    let x = event.clientX - rect.left + 12;
    let y = event.clientY - rect.top + 12;
    if (x + tw > rect.width - 8) x = event.clientX - rect.left - tw - 12;
    if (y + th > rect.height - 8) y = event.clientY - rect.top - th - 12;
    x = Math.max(8, Math.min(rect.width - tw - 8, x));
    y = Math.max(8, Math.min(rect.height - th - 8, y));
    tooltip.style.left = `${x}px`;
    tooltip.style.top = `${y}px`;
  }

  function showTooltip(event, html) {
    tooltip.innerHTML = html;
    tooltip.hidden = false;
    placeTooltip(event);
  }

  function hideTooltip() {
    tooltip.hidden = true;
  }

  for (const mark of root.querySelectorAll('[data-paper-id]')) {
    const id = mark.getAttribute('data-paper-id');
    const p = id ? byId.get(id) : null;
    if (!p) continue;

    mark.tabIndex = 0;
    mark.setAttribute('role', 'button');
    mark.setAttribute(
      'aria-label',
      `${p.title} (${p.year}) · ${p.label}${p.venue ? ` · ${p.venue}` : ''}`,
    );

    mark.addEventListener('pointerenter', (event) => {
      showTooltip(
        event,
        `<strong>${p.title}</strong><br>${p.year} · ${p.label}${p.venue ? ` · ${p.venue}` : ''}<br><span style="opacity:.7">Click to open DOI</span>`,
      );
    });
    mark.addEventListener('pointermove', (event) => {
      if (!tooltip.hidden) placeTooltip(event);
    });
    mark.addEventListener('pointerleave', hideTooltip);
    mark.addEventListener('click', () => {
      window.open(p.url, '_blank', 'noopener,noreferrer');
    });

    mark.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      window.open(p.url, '_blank', 'noopener,noreferrer');
    });
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion) {
    stage.classList.add('is-inview');
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          stage.classList.add('is-inview');
          io.disconnect();
        }
      },
      { threshold: 0.35, rootMargin: '0px 0px -8% 0px' },
    );
    io.observe(stage);
  }
</script>
