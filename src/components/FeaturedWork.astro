---
import type { Work } from '../lib/schema';

interface Props {
  works: Work[];
}

const { works } = Astro.props;
---

<section class="section section--band" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <h2 class="section__title" id="work-title">Selected work</h2>
    <p class="section__lead">
      Pipelines and studies where the biological question and the software deliverable travel together.
    </p>

    <div class="works">
      {
        works.map((work) => (
          <article class="work">
            <header class="work__head">
              <p class="work__meta">
                {work.year} · {work.venueLabel}
              </p>
              <h3 class="work__title">{work.title}</h3>
              <p class="work__subtitle">{work.subtitle}</p>
            </header>
            <dl class="work__fields">
              <div>
                <dt>Problem</dt>
                <dd class="prose">{work.problem.trim()}</dd>
              </div>
              <div>
                <dt>Method</dt>
                <dd class="prose">{work.method.trim()}</dd>
              </div>
              <div>
                <dt>Impact</dt>
                <dd class="prose">{work.impact.trim()}</dd>
              </div>
            </dl>
            <ul class="work__tags">
              {work.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <p class="work__links">
              {work.links.repo && (
                <a class="work__link" href={work.links.repo}>
                  Repository
                </a>
              )}
              {work.links.pubmed && (
                <a class="work__link" href={work.links.pubmed}>
                  PubMed
                </a>
              )}
              {work.links.doi && (
                <a class="work__link" href={work.links.doi}>
                  DOI
                </a>
              )}
              {work.links.docs && (
                <a class="work__link" href={work.links.docs}>
                  Docs
                </a>
              )}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .works {
    display: flex;
    flex-direction: column;
  }

  .work {
    padding: 1.75rem 0;
    border-top: 1px solid var(--border);
  }

  .work:last-child {
    border-bottom: 1px solid var(--border);
  }

  .work__meta {
    margin: 0 0 0.35rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
  }

  .work__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .work__subtitle {
    margin: 0.25rem 0 1.1rem;
    color: var(--muted);
  }

  .work__fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 1.1rem;
  }

  .work__fields dt {
    margin: 0 0 0.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .work__fields dd {
    margin: 0;
    color: var(--ink);
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
  }

  .work__tags li {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }

  .work__tags li:not(:last-child)::after {
    content: '·';
    margin-left: 0.65rem;
    color: var(--border);
  }

  .work__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0;
  }

  .work__link {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    transition: border-color 160ms var(--ease), color 160ms var(--ease);
  }

  .work__link:hover {
    border-bottom-color: var(--accent);
  }
</style>
