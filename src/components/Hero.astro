---
import { Image } from 'astro:assets';
import type { Bio } from '../lib/schema';
import portrait from '../assets/images/n.moldovan.jpeg';

interface Props {
  bio: Bio;
}

const { bio } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="wrap hero__content">
    <div class="hero__intro">
      <div class="hero__portrait">
        <Image
          class="hero__photo"
          src={portrait}
          alt="Norbert Moldován"
          width={320}
          height={320}
          densities={[1.5, 2]}
          format="webp"
          quality={82}
        />
        <a class="hero__avail" href="#now">
          <span class="hero__avail-dot" aria-hidden="true"></span>
          <span class="hero__avail-text">Open for work</span>
        </a>
      </div>
      <div class="hero__copy">
        <h1 id="hero-name" class="hero__name">{bio.name}</h1>
        <p class="hero__title-line">{bio.title} · {bio.tagline}</p>
        <p class="hero__pitch">{bio.pitch.trim()}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={bio.cv.primary.href} download target="_blank" rel="noopener noreferrer">
            {bio.cv.primary.label}
          </a>
          <a class="btn btn--primary" href={`mailto:${bio.email}`}>{bio.email}</a>
          {
            bio.cv.secondary && (
              <a class="link-quiet hero__cv-alt" href={bio.cv.secondary.href} download target="_blank" rel="noopener noreferrer">
                {bio.cv.secondary.label}
              </a>
            )
          }
        </div>
      </div>
    </div>
    <div class="hero__bar">
      <ul class="hero__links">
        <li>
          <a href={bio.links.github} aria-label="GitHub" title="GitHub" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={bio.links.scholar} aria-label="Google Scholar" title="Google Scholar" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={bio.links.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={bio.links.orcid} aria-label="ORCID" title="ORCID" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.688-1.381 3.688-3.722 0-2.247-1.337-3.722-3.722-3.722h-2.263z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
      <dl class="hero__metrics">
        <div>
          <dt>
            Citations
            <span class="hero__metric-hint" tabindex="0">
              <span class="hero__metric-q" aria-hidden="true">?</span>
              <span class="hero__metric-tip" role="tooltip"
                >Times publications have been cited by other scholarly works (Google Scholar).</span
              >
            </span>
          </dt>
          <dd>
            <a href={bio.links.scholar} target="_blank" rel="noopener noreferrer">{bio.metrics.citations.toLocaleString('en-US')}</a>
          </dd>
        </div>
        <div>
          <dt>
            h-index
            <span class="hero__metric-hint" tabindex="0">
              <span class="hero__metric-q" aria-hidden="true">?</span>
              <span class="hero__metric-tip" role="tooltip"
                >h papers each cited at least h times (Google Scholar).</span
              >
            </span>
          </dt>
          <dd>
            <a href={bio.links.scholar} target="_blank" rel="noopener noreferrer">{bio.metrics.hIndex}</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
  <a class="hero__scroll" href="#expertise" data-hero-scroll>
    <span class="hero__scroll-label">Scroll to see more!</span>
    <svg class="hero__scroll-arrow" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M6 10l6 6 6-6"
      ></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    padding: clamp(3rem, 10vw, 5.5rem) 0;
    overflow: hidden;
    background:
      radial-gradient(720px 380px at 12% 40%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 68%),
      radial-gradient(900px 420px at 88% 8%, var(--accent-soft), transparent 70%),
      var(--surface);
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: center;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .hero__portrait {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    width: clamp(9.5rem, 22vw, 14rem);
    flex-shrink: 0;
    animation: rise 700ms var(--ease) both;
  }

  .hero__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border: 2px solid #fff;
    border-radius: calc(100% * 3 / 21);
    object-fit: cover;
  }

  .hero__avail {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: clamp(0.62rem, 1.5vw, 0.72rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 160ms var(--ease);
  }

  .hero__avail:hover {
    color: var(--accent);
  }

  .hero__avail:hover .hero__avail-text {
    -webkit-text-fill-color: var(--accent);
  }

  .hero__avail:hover .hero__avail-dot {
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  /*
   * Load shimmer (Siri/Google-style sweep): cool teal → slate → mint highlight,
   * settling on the steady availability green. Professional, on-brand with --accent.
   */
  .hero__avail-text {
    background-image: linear-gradient(
      105deg,
      #0d6e6e 0%,
      #1a6f7c 16%,
      #2f7f9a 32%,
      #5eb8a8 46%,
      #b8ebe0 52%,
      #5eb8a8 58%,
      #2a9b78 78%,
      #2a9b78 100%
    );
    background-size: 240% 100%;
    background-position: 100% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation:
      avail-shimmer-sweep 1.667s var(--ease) 3,
      avail-shimmer-settle 0.01s linear 5s forwards;
  }

  .hero__avail-dot {
    width: 0.4rem;
    height: 0.4rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: #0d6e6e;
    box-shadow: 0 0 8px color-mix(in srgb, #0d6e6e 55%, transparent);
    animation:
      avail-shimmer-dot 1.667s var(--ease) 3 forwards,
      avail-pulse 2.2s var(--ease) 5s infinite;
  }

  @keyframes avail-shimmer-sweep {
    from {
      background-position: 100% 50%;
      -webkit-text-fill-color: transparent;
    }
    to {
      background-position: 0% 50%;
      -webkit-text-fill-color: transparent;
    }
  }

  @keyframes avail-shimmer-settle {
    to {
      -webkit-text-fill-color: #2a9b78;
    }
  }

  @keyframes avail-shimmer-dot {
    0% {
      background: #0d6e6e;
      box-shadow: 0 0 8px color-mix(in srgb, #0d6e6e 55%, transparent);
    }
    28% {
      background: #2f7f9a;
      box-shadow: 0 0 8px color-mix(in srgb, #2f7f9a 55%, transparent);
    }
    52% {
      background: #5eb8a8;
      box-shadow: 0 0 10px color-mix(in srgb, #5eb8a8 60%, transparent);
    }
    100% {
      background: #2a9b78;
      box-shadow: 0 0 8px color-mix(in srgb, #2a9b78 55%, transparent);
    }
  }

  @keyframes avail-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__avail-text {
      animation: none;
      background: none;
      color: var(--accent);
      -webkit-text-fill-color: var(--accent);
    }

    .hero__avail-dot {
      animation: none;
      background: var(--accent);
      box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 55%, transparent);
    }
  }

  .hero__copy {
    min-width: 0;
    animation: rise 700ms var(--ease) 80ms both;
  }

  .hero__name {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 6.5vw, 4.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero__title-line {
    margin: 0 0 1rem;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    font-weight: 500;
    color: var(--muted);
  }

  .hero__pitch {
    margin: 0 0 1.5rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.8vw, 1.15rem);
    line-height: 1.55;
    color: var(--muted);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .hero__cv-alt {
    font-size: 0.95rem;
  }

  .hero__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin: 0;
    padding: 1.15rem 0 0;
    border-top: 1px solid var(--border);
    animation: rise 700ms var(--ease) 160ms both;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink);
    text-decoration: none;
    border-radius: 3px;
    transition: color 160ms var(--ease), background 160ms var(--ease);
  }

  .hero__links a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .hero__links svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .hero__metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.25rem 1.75rem;
    margin: 0;
  }

  .hero__metrics div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .hero__metrics dt {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__metric-hint {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    cursor: help;
  }

  .hero__metric-q {
    display: inline-grid;
    place-items: center;
    width: 0.95rem;
    height: 0.95rem;
    border: 1px solid color-mix(in srgb, var(--muted) 55%, transparent);
    border-radius: 50%;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    color: var(--muted);
    transition:
      color 160ms var(--ease),
      border-color 160ms var(--ease),
      background 160ms var(--ease);
  }

  .hero__metric-hint:hover .hero__metric-q,
  .hero__metric-hint:focus .hero__metric-q,
  .hero__metric-hint:focus-visible .hero__metric-q {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .hero__metric-hint:focus {
    outline: none;
  }

  .hero__metric-hint:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 50%;
  }

  .hero__metric-tip {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.45rem);
    z-index: 5;
    width: max-content;
    max-width: 14rem;
    padding: 0.45rem 0.55rem;
    border-radius: 0.45rem;
    background: var(--ink);
    color: var(--surface);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.35;
    text-transform: none;
    text-align: left;
    box-shadow: 0 6px 18px rgba(15, 23, 32, 0.18);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(0.15rem);
    transition:
      opacity 160ms var(--ease),
      transform 160ms var(--ease),
      visibility 160ms var(--ease);
  }

  .hero__metric-hint:hover .hero__metric-tip,
  .hero__metric-hint:focus .hero__metric-tip,
  .hero__metric-hint:focus-within .hero__metric-tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .hero__metrics dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-align: left;
  }

  .hero__metrics a {
    color: inherit;
    text-decoration: none;
  }

  .hero__metrics a:hover {
    color: var(--accent);
  }

  .hero__scroll {
    position: absolute;
    left: max(1rem, calc((100% - var(--max)) / 2 + 1rem));
    bottom: 1.35rem;
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.2;
    animation: hero-scroll-nudge 2.4s var(--ease) infinite;
    transition:
      opacity 280ms var(--ease),
      transform 280ms var(--ease),
      color 160ms var(--ease);
  }

  .hero__scroll:hover {
    color: var(--accent);
  }

  .hero__scroll.is-away {
    opacity: 0 !important;
    pointer-events: none;
    animation: none;
    transform: translateY(0.4rem);
  }

  .hero__scroll-arrow {
    width: 1.15rem;
    height: 1.15rem;
  }

  @keyframes hero-scroll-nudge {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.72;
    }
    50% {
      transform: translateY(0.35rem);
      opacity: 1;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero__intro {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 1.75rem;
    }

    .hero__portrait {
      width: clamp(8rem, 42vw, 11rem);
    }

    .hero__scroll {
      left: 1rem;
      bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll {
      animation: none;
      opacity: 0.85;
    }
  }
</style>

<script>
  const hero = document.getElementById('top');
  const cue = document.querySelector('[data-hero-scroll]');
  if (hero instanceof HTMLElement && cue instanceof HTMLElement) {
    const setAway = (away) => {
      cue.classList.toggle('is-away', away);
      cue.setAttribute('aria-hidden', away ? 'true' : 'false');
      if (away) cue.setAttribute('tabindex', '-1');
      else cue.removeAttribute('tabindex');
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        // Hide once most of the hero has left the viewport; show when back on hero.
        setAway(!entry.isIntersecting || entry.intersectionRatio < 0.55);
      },
      { threshold: [0, 0.35, 0.55, 0.75, 1] },
    );
    io.observe(hero);
  }
</script>
