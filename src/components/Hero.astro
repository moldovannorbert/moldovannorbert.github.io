---
import type { Bio } from '../lib/schema';

interface Props {
  bio: Bio;
}

const { bio } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="wrap hero__content">
    <h1 id="hero-name" class="hero__name">{bio.name}</h1>
    <p class="hero__title-line">{bio.title} · {bio.tagline}</p>
    <p class="hero__pitch prose">{bio.pitch.trim()}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href={bio.cv.primary.href} download>
        {bio.cv.primary.label}
      </a>
      {
        bio.cv.secondary && (
          <a class="link-quiet hero__cv-alt" href={bio.cv.secondary.href} download>
            {bio.cv.secondary.label}
          </a>
        )
      }
    </div>
    <ul class="hero__links">
      <li><a href={bio.links.github}>GitHub</a></li>
      <li><a href={bio.links.scholar}>Google Scholar</a></li>
      <li><a href={bio.links.linkedin}>LinkedIn</a></li>
      <li><a href={bio.links.orcid}>ORCID</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    padding: clamp(3rem, 10vw, 5.5rem) 0;
    background:
      radial-gradient(900px 420px at 85% 0%, var(--accent-soft), transparent 70%),
      var(--surface);
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__name {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
    animation: rise 700ms var(--ease) both;
  }

  .hero__title-line {
    margin: 0 0 1.1rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
    animation: rise 700ms var(--ease) 60ms both;
  }

  .hero__pitch {
    margin: 0 0 1.75rem;
    font-size: 1.1rem;
    color: var(--muted);
    animation: rise 700ms var(--ease) 120ms both;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    animation: rise 700ms var(--ease) 180ms both;
  }

  .hero__cv-alt {
    font-size: 0.95rem;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: rise 700ms var(--ease) 240ms both;
  }

  .hero__links a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms var(--ease), color 160ms var(--ease);
  }

  .hero__links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
