---
import type { Bio } from '../lib/schema';

interface Props {
  bio: Bio;
}

const { bio } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 class="section__title" id="contact-title">Contact</h2>
    <p class="section__lead">
      Open to roles in genomics, oncology, and bioinformatics infrastructure.
    </p>
    <p class="contact__email">
      <a class="btn btn--primary" href={`mailto:${bio.email}`}>{bio.email}</a>
    </p>
    <ul class="contact__links">
      <li><a href={bio.links.linkedin}>LinkedIn</a></li>
      <li><a href={bio.links.github}>GitHub</a></li>
      <li><a href={bio.links.scholar}>Google Scholar</a></li>
      <li><a href={bio.links.orcid}>ORCID</a></li>
    </ul>
    <p class="contact__meta">
      © {year} {bio.name} · {bio.location} · Built with Astro ·
      <a href="/corpus.json">Public corpus</a>
    </p>
  </div>
</footer>

<style>
  .contact {
    border-top: 1px solid var(--border);
  }

  .contact__email {
    margin: 0 0 1.25rem;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 2.25rem;
    padding: 0;
    list-style: none;
  }

  .contact__links a {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .contact__links a:hover {
    border-bottom-color: var(--accent);
  }

  .contact__meta {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .contact__meta a {
    color: var(--muted);
  }

  .contact__meta a:hover {
    color: var(--accent);
  }
</style>
