---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Skills } from '../lib/schema';

interface Props {
  skills: Skills;
}

const { skills } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/expertise/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

function resolveImage(filename: string): ImageMetadata {
  const key = `../assets/images/expertise/${filename}`;
  const mod = imageModules[key];
  if (!mod) throw new Error(`Missing expertise image: ${filename}`);
  return mod.default;
}

function detailBlocks(detail: Skills['pillars'][number]['items'][number]['detail']) {
  if (typeof detail === 'string') return [{ text: detail }];
  return detail;
}

function isCaseStudyBlock(block: { heading?: string; text: string }) {
  return Boolean(block.heading && /^case stud/i.test(block.heading));
}

/** Turn `Label (https://…)` runs into link segments; multiple runs get a line break between them. */
function parseRichText(raw: string) {
  type Part =
    | { kind: 'text'; value: string }
    | { kind: 'link'; label: string; href: string }
    | { kind: 'br' };

  // We store link titles as `Label (https://...)` but some URLs contain parentheses
  // themselves (e.g. `S2589-0042(24)01967-9`), so we cannot use a naive regex.
  const parts: Part[] = [];
  let cursor = 0;
  let links = 0;

  while (cursor < raw.length) {
    const httpsIdx = raw.indexOf('https://', cursor);
    const httpIdx = raw.indexOf('http://', cursor);
    const urlStart =
      httpsIdx === -1 ? httpIdx : httpIdx === -1 ? httpsIdx : Math.min(httpsIdx, httpIdx);
    if (urlStart === -1) break;

    // Find the `(` right before the URL (allowing whitespace after it).
    let p = urlStart - 1;
    while (p >= 0 && /\s/.test(raw[p])) p -= 1;
    if (p < 0 || raw[p] !== '(') break;
    const openParenIndex = p;

    // Find the matching `)` for `openParenIndex`, allowing nested parentheses inside the URL.
    let depth = 0;
    let closeParenIndex: number | null = null;
    for (let i = openParenIndex + 1; i < raw.length; i += 1) {
      const ch = raw[i];
      if (ch === '(') depth += 1;
      else if (ch === ')') {
        if (depth === 0) {
          closeParenIndex = i;
          break;
        }
        depth -= 1;
      }
    }
    if (closeParenIndex == null) break;

    const label = raw.slice(cursor, openParenIndex).trim();
    const href = raw.slice(urlStart, closeParenIndex).trim();

    if (links > 0) parts.push({ kind: 'br' });
    parts.push({
      kind: 'link',
      label: label || href,
      href,
    });

    links += 1;
    cursor = closeParenIndex + 1;
  }

  const rest = raw.slice(cursor).trim();
  if (parts.length === 0) return [{ kind: 'text', value: raw }];
  if (rest) parts.push({ kind: 'text', value: rest });
  return parts;
}
---

<section class="section" id="expertise" aria-labelledby="expertise-title">
  <div class="wrap">
    <h2 class="section__title" id="expertise-title">Expertise</h2>
    <p class="section__lead">
      Building reproducible HPC pipelines and classifiers for multi-omic data.
    </p>
    <div class="pillars">
      {
        skills.pillars.map((pillar) => (
          <div class="pillar">
            <h3 class="pillar__title">{pillar.title}</h3>
            <ul class="pillar__list">
              {pillar.items.map((item) => {
                const blocks = detailBlocks(item.detail);
                const caseStudies = blocks.filter(isCaseStudyBlock);
                const ordered = [
                  ...caseStudies,
                  ...blocks.filter((b) => !isCaseStudyBlock(b)),
                ];
                const caseHeading =
                  caseStudies.length > 1
                    ? 'Case studies'
                    : (caseStudies[0]?.heading ?? 'Case study');
                return (
                <li>
                  <div class="skill-card" tabindex="0">
                    <span class="skill-card__media" aria-hidden="true">
                      <Image
                        class="skill-card__img"
                        src={resolveImage(item.image)}
                        alt=""
                        width={640}
                        height={640}
                        densities={[1.5, 2]}
                        format="webp"
                        quality={78}
                      />
                      <span class="skill-card__scrim" />
                    </span>
                    <span class="skill-card__body">
                      <span class="skill-card__label">{item.label}</span>
                      {
                        caseStudies.length > 0 && (
                          <span class="skill-card__subhead skill-card__case-head">{caseHeading}</span>
                        )
                      }
                      <span class="skill-card__detail">
                        <span class="skill-card__detail-inner">
                          {
                            ordered.map((block) => (
                              <span class="skill-card__block">
                                {
                                  block.heading && !isCaseStudyBlock(block) ? (
                                    <span class="skill-card__subhead">{block.heading}</span>
                                  ) : null
                                }
                                <span class="skill-card__text">
                                  {parseRichText(block.text).map((part) =>
                                    part.kind === 'br' ? (
                                      <br />
                                    ) : part.kind === 'link' ? (
                                      <a
                                        href={part.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                      >
                                        {part.label}
                                      </a>
                                    ) : (
                                      part.value
                                    ),
                                  )}
                                </span>
                              </span>
                            ))
                          }
                        </span>
                      </span>
                    </span>
                  </div>
                </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pillar__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pillar__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-card {
    --card-radius: 1.15rem;
    --card-border: 2px;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: var(--skill-card-min-h, 0);
    margin: 0;
    padding: 0;
    border: var(--card-border) solid #fff;
    /* Soft rounded rect — fixed radius so short cards don’t become pills. */
    border-radius: var(--card-radius);
    background: transparent;
    box-shadow: 0 2px 12px rgba(15, 23, 32, 0.08);
    color: #fff;
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition: box-shadow 220ms var(--ease);
    isolation: isolate;
  }

  .skill-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .skill-card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Inner radius must be the outer radius minus the border, or the square
       image corners bleed past the curve. */
    border-radius: calc(var(--card-radius) - var(--card-border));
    transform: translateZ(0);
  }

  .skill-card__media :global(picture),
  .skill-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .skill-card__img {
    object-fit: cover;
    filter: grayscale(1) brightness(0.8);
    transition: filter 320ms var(--ease), transform 420ms var(--ease);
  }

  .skill-card:hover .skill-card__img,
  .skill-card:focus .skill-card__img,
  .skill-card:focus-within .skill-card__img {
    filter: grayscale(0) brightness(0.8);
    transform: scale(1.03);
  }

  /* In manual high-contrast mode, force expertise-card images to black for readability. */
  [data-contrast='high'] .skill-card__media :global(img),
  [data-contrast='high'] .skill-card__img {
    filter: grayscale(1) brightness(0);
    transform: none;
  }

  [data-contrast='high'] .skill-card:hover .skill-card__media :global(img),
  [data-contrast='high'] .skill-card:focus .skill-card__media :global(img),
  [data-contrast='high'] .skill-card:focus-within .skill-card__media :global(img),
  [data-contrast='high'] .skill-card:hover .skill-card__img,
  [data-contrast='high'] .skill-card:focus .skill-card__img,
  [data-contrast='high'] .skill-card:focus-within .skill-card__img {
    filter: grayscale(1) brightness(0);
    transform: none;
  }

  .skill-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 18, 20, 0.2) 0%,
      rgba(18, 18, 20, 0.55) 55%,
      rgba(18, 18, 20, 0.8) 100%
    );
    pointer-events: none;
  }

  .skill-card__body {
    position: relative;
    z-index: 3;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
    width: 100%;
    padding: 0.85rem 1rem;
  }

  .skill-card__label {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .skill-card__case-head {
    display: block;
    margin-top: 0.4rem;
  }

  .skill-card__detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      grid-template-rows 320ms var(--ease),
      opacity 240ms var(--ease),
      margin-top 320ms var(--ease);
  }

  .skill-card__detail-inner {
    overflow: hidden;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.88);
  }

  .skill-card__block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .skill-card__subhead {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.95);
  }

  .skill-card__text {
    display: block;
  }

  .skill-card__text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .skill-card__text a:hover {
    color: #fff;
  }

  .skill-card:hover .skill-card__detail,
  .skill-card:focus .skill-card__detail,
  .skill-card:focus-within .skill-card__detail {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 0.35rem;
    visibility: visible;
    pointer-events: auto;
  }

  @media (max-width: 860px) {
    .pillars {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card__img,
    .skill-card__detail {
      transition: none;
    }

    .skill-card:hover .skill-card__img,
    .skill-card:focus .skill-card__img,
    .skill-card:focus-within .skill-card__img {
      transform: none;
    }
  }
</style>

<script>
  function syncSkillCardHeights() {
    const root = document.getElementById('expertise');
    if (!root) return;
    const cards = root.querySelectorAll('.skill-card');
    if (!cards.length) return;

    root.style.removeProperty('--skill-card-min-h');
    void root.offsetHeight;

    let max = 0;
    for (const card of cards) {
      max = Math.max(max, card.getBoundingClientRect().height);
    }
    root.style.setProperty('--skill-card-min-h', `${Math.ceil(max)}px`);
  }

  let resizeTimer = 0;
  function onResize() {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(syncSkillCardHeights, 100);
  }

  syncSkillCardHeights();
  window.addEventListener('resize', onResize);
  document.fonts?.ready.then(syncSkillCardHeights);
</script>
