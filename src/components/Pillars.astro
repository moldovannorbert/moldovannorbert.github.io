---
import type { Skills } from '../lib/schema';

interface Props {
  skills: Skills;
}

const { skills } = Astro.props;
---

<section class="section" id="expertise" aria-labelledby="expertise-title">
  <div class="wrap">
    <h2 class="section__title" id="expertise-title">Expertise</h2>
    <p class="section__lead">
      Liquid biopsy methods, ML for genomic data, and reproducible HPC pipelines.
    </p>
    <div class="pillars">
      {
        skills.pillars.map((pillar) => (
          <div class="pillar">
            <h3 class="pillar__title">{pillar.title}</h3>
            <ul class="pillar__list">
              {pillar.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .pillar__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pillar__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillar__list li {
    padding: 0.4rem 0;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .pillar__list li + li {
    border-top: none;
  }

  @media (max-width: 860px) {
    .pillars {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
